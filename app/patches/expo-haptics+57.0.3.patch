+/**
+ * Warm the Taptic Engine / Core Haptics engine so the next selection tick
+ * is not dropped. No-ops when the native module is absent.
+ */
+export async function prepareSelectionAsync(): Promise<void> {
+  if (!ExpoHaptics?.prepareSelectionAsync) {
+    return;
+  }
+  await ExpoHaptics.prepareSelectionAsync();
+}
