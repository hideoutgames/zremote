# Expo CNG: ios/ and android/ are generated by `npx expo prebuild` from
# app/app.config.ts + app/plugins/ (docs/COMPATIBILITY.md "Native project
# strategy"). The committed templates were removed after prebuild was
# verified to reproduce them; a pre-CNG backup lives at _ref/native-backup/.
/app/ios
/app/android

# Expo / E2E harness artifacts
/app/.expo
/app/.e2e

# e2e harness logs (any location)
**/.e2e/
